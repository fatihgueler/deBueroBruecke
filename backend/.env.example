# Anthropic API Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_key_here

# JWT Secret (mindestens 32 Zeichen, generieren mit: openssl rand -hex 32)
SECRET_KEY=your_jwt_secret_here_min_32_chars_long_random_string

# Datenbank
DATABASE_URL=sqlite+aiosqlite:///./buerbruecke.db

# Upload-Konfiguration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# CORS - Komma-getrennte Liste erlaubter Origins
CORS_ORIGINS=http://localhost:5173

# Environment
ENVIRONMENT=development
